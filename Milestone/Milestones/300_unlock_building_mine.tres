script = ExtResource("1_6awk8")
id = "beneath_the_roots"
name = "Beneath the Roots"
description = "As your settlement grows, the people look beyond the forest floor. Tools are sharpened for stone and ore, and the first shafts are dug into the earth. Beneath the roots of the great trees lies a new wealth, waiting to be claimed."
effect_description = "Unlocks the Mine building, allowing extraction of stone and ore."
effect_id = "unlock_building_mine"
effect_power = 1
cost = {
"wood": 200
}
